#!/bin/bash

if [ -f ~/.bashrc ] 
then
    source ~/.bashrc # .bashrc checks if in interactive shell
fi

# start with basic paths
export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/lib
export PATH=/usr/local/bin:/usr/bin:/bin:/sbin

# add WRF stuff
export WRF_HOME=/home/user/wrf
export WRF_MPI=MPICH
export WRF_JCL=NONE
export WRF_OPENMP_NCORES=NONE
export WRF_MPICH_HOSTS=/home/user/mpd.hosts

# for MAC OS/X
export FI_PROVIDER=tcp

export LD_LIBRARY_PATH=/home/user/wrf/lib:$LD_LIBRARY_PATH
export PATH=/home/user/bin:$PATH
