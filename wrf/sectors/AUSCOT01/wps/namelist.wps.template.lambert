&share
 wrf_core = 'ARW',
 max_dom = 3,
 start_date = '2020-06-20_00:00:00', '2020-06-20_00:00:00', '2020-06-20_00:00:00',
 end_date   = '2020-06-20_00:00:00', '2020-06-21_00:00:00', '2020-06-21_00:00:00',
 interval_seconds = 21600,
 io_form_geogrid = 2,
 nocolons = .true.
/

&geogrid
 parent_id         = 1,1,2,
 parent_grid_ratio = 1,3,3,
 i_parent_start    = 1,58,58,
 j_parent_start    = 1,58,58,
 e_we          = 172,172,172,
 e_sn          = 172,172,172,
 geog_data_res = '20m+default','20m+default','20m+default',
 dx = 30000,
 dy = 30000,
 map_proj =  'lambert',
 ref_lat   = -29.4300,
 ref_lon   = 149.1700,
 truelat1  = -30.0000,
 truelat2  = -60.0000,
 stand_lon = 149.1700,
 geog_data_path = '/home/agrineer/wrf/WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE'
 io_form_metgrid = 2, 
/
