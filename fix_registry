sed -i.bak 's/state   real    swddni2      ij     misc         1         -     rd /state   real    swddni2      ij     misc         1         -     rhd/' ./Registry.EM_COMMON && rm Registry.EM_COMMON.bak
if [ $status -gt 0 ]
then
    echo "fix_registry: could not edit Registry.EM_COMMON for variable SWDDNI2"
    exit 1
fi

sed -i.bak 's/state   real    swddnic      ij     misc         1         -     rd /state   real    swddnic      ij     misc         1         -     rhd/' ./Registry.EM_COMMON && rm Registry.EM_COMMON.bak
if [ $status -gt 0 ]
then
