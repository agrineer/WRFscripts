fi

sed -i.bak 's/state   real    swddif       ij     misc         1         -     rd /state   real    swddif       ij     misc         1         -     rhd/' ./Registry.EM_COMMON && rm Registry.EM_COMMON.bak
if [ $status -gt 0 ]
