untar_package()
{
    echo "untar'ing ${PNAME}.${SUFFIX}"
    tar xvf $PNAME.$SUFFIX
    status=$?
    if [ $status -gt 0 ]
    then
	echo "INSTALL_LIBS_PNETCDF_IO: could not untar ${PNAME}.${SUFFIX}"
	exit 1
    fi
}

# test and report configure
check_configure()
{
    if [ ${PIPESTATUS[0]} -gt 0 ]
    then
	echo "INSTALL_LIBS_PNETCDF_IO: could not configure ${PNAME}"
	echo "review ${WRFscripts}/wrf/packages/${PNAME}/${PNAME}_config.log"
	echo "and ${WRFscripts}/wrf/packages/${PNAME}/config.log for details"
	exit 1
    fi
}

# test and report make
check_make()
{
    if [ ${PIPESTATUS[0]} -gt 0 ]
    then
	echo "INSTALL_LIBS_PNETCDF_IO: could not make ${PNAME}"
	echo "review ${WRFscripts}/wrf/packages/${PNAME}/${PNAME}_make.log for details"
	exit 1
    fi
}

# test and report make install
check_make_install()
{
    if [ ${PIPESTATUS[0]} -gt 0 ]
    then
	echo "INSTALL_LIBS_PNETCDF_IO: could not make install ${PNAME}"
	echo "review ${WRFscripts}/wrf/packages/${PNAME}/${PNAME}_make_install.log for details"
	exit 1
    fi
}

print_env()
{
    echo ""
    echo "installing ${PNAME} with these variable values:"

    # print variable if populated

    if [ "$CC" != "" ]
    then
	echo "CC=${CC}"
    fi

    if [ "$MPICC" != "" ]
    then
	echo "MPICC=${MPICC}"
    fi

    if [ "$CFLAGS" != "" ]
    then
	echo "CFLAGS=${CFLAGS}"
    fi

    if [ "$CPPFLAGS" != "" ]
    then
	echo "CPPFLAGS=${CPPFLAGS}"
    fi

    if [ "$FC" != "" ]
    then
	echo "FC=${FC}"
    fi

    if [ "$FCFLAGS" != "" ]
    then
	echo "FCFLAGS=${FCFLAGS}"
    fi

    if [ "$MPIF90" != "" ]
    then
	echo "MPIF90=${MPIF90}"
    fi

    if [ "$LD_LIBRARY_PATH" != "" ]
    then
	echo "LD_LIBRARY_PATH=${LD_LIBRARY_PATH}"
    fi
    
    if [ "$LDFLAGS" != "" ]
    then
	echo "LDFLAGS=${LDFLAGS}"
    fi

    if [ "$FFLAGS" != "" ]
    then
	echo "CPPFLAGS=${CPPFLAGS}"
    fi

    echo "CONF_PARAMS=${CONF_PARAMS}"  # must always have CONF_PARAMS
    echo ""
}

make_lib()
{
    print_env
    
    cd $WRFscripts/packages
    rm -rf $PNAME

    untar_package # parameters are PNAME and SUFFIX
    cd $PNAME
   
    echo "configuring ${PNAME} on ${HOSTNAME}"

    ./configure $CONF_PARAMS 2>&1 | tee ${PNAME}_config.log
    check_configure

    echo "making ${PNAME}"
    make -j4 2>&1 | tee ${PNAME}_make.log
    check_make
    
    echo "make install ${PNAME}"
    make install 2>&1 | tee ${PNAME}_make_install.log
    check_make_install

    echo "installing ${PNAME} done"
}

# clear all environment variables used in this script
clear_vars()
{
    unset PNAME
    unset SUFFIX
    unset CC
    unset MPICC
    unset CPPFLAGS
    unset FC
    unset FCFLAGS
    unset MPIF90
    unset LD_LIBRARY_PATH
    unset LDFLAGS
    unset CONF_PARAMS
    unset FFLAGS
}

#----------------------------------------------------------------------
# main

# INSTALL WRF dependent libraries
echo ""
echo "Installing PNETCDF I/O WRF dependent libraries"

export PATH=$WRFscripts/wrf/bin:$PATH

cd $WRFscripts/wrf

echo "cleaning ${WRFscripts}/wrf/include"
rm -rf include
mkdir include

echo "cleaning ${WRFscripts}/wrf/lib"
rm -rf lib
mkdir lib

echo "cleaning ${AGRINEER_WRF}/wrf/bin"
rm -rf bin
mkdir bin
cd bin
ln -s ../scripts/getdata_gfs.py
ln -s ../scripts/runwrf

# source URL for mpich
# https://www.mpich.org/downloads/
# install MPICH or OPENMP
clear_vars
if [ ${INSTALL_WRF_MPI} = "MPICH" ]
then
    PNAME=mpich-4.2.1         # package name
    SUFFIX=tar.gz
    
    # TODO:check for valid device
    DEVICE="--with-device=${INSTALL_WRF_IO_CHANNEL}"
    echo "INSTALL_LIBS_PNETCDF_IO: compiling MPICH with channel ${INSTALL_WRF_IO_CHANNEL}"

    if [ ${INSTALL_WRF_USE_CUDA} = "NONE" ]
    then
	CUDA="--without-cuda"
	echo "INSTALL_LIBS_PNETCDF_IO: compiling MPICH without CUDA"
    else
	if [ -d "${INSTALL_WRF_USE_CUDA}" ]
	then
	    CUDA="--with-cuda=${INSTALL_WRF_USE_CUDA}"
	    echo "INSTALL_LIBS_PNETCDF_IO: compiling MPICH with CUDA=${INSTALL_WRF_USE_CUDA}"
	else
	    echo "INSTALL_LIBS_PNETCDF_IO: CUDA directory ${INSTALL_WRF_USE_CUDA} does not exist...exiting"
	    exit 1
	fi
    fi

    CONF_PARAMS="--prefix=${AGRINEER_WRF}/wrf ${CUDA} ${DEVICE}"
    make_lib
fi

# source URL for openmpi?
if [ ${INSTALL_WRF_MPI} = "OPENMP" ]
then
    # check if libgomp and mpirun exist

    
    # if not then compile OPENMP
    echo "INSTALL_LIBS_SERIAL_IO: compiling OPENMP"
    PNAME=openmpi-5.0.3
    SUFFIX=tar.bz2
    
    CONF_PARAMS="--prefix=${AGRINEER_WRF}/wrf"
    make_lib
fi

# netCDF-c can be configured and compiled with pNetcdf solely,
# that is, without HDF5. 

# wget parallel-netcdf.github.io/Release/pnetcdf-1.12.3.tar.gz
clear_vars
PNAME=pnetcdf-1.12.3
SUFFIX=tar.gz
CONF_PARAMS="--prefix=${AGRINEER_WRF}/wrf --enable-fortran --enable-shared"
export CC=$AGRINEER_WRF/wrf/bin/mpicc
export MPICC=$AGRINEER_WRF/wrf/bin/mpicc
export CPPFLAGS=-I$AGRINEER_WRF/wrf/include
export MPIF90=$AGRINEER_WRF/wrf/bin/mpif90
export FC=$AGRINEER_WRF/wrf/bin/mpif90
export LDFLAGS=-L$AGRINEER_WRF/wrf/lib
make_lib

# wget https://downloads.unidata.ucar.edu/netcdf-c/4.9.2/netcdf-c-4.9.2.tar.gz
clear_vars
PNAME=netcdf-c-4.9.2
SUFFIX=tar.gz
#CONF_PARAMS=--prefix=$AGRINEER_WRF/wrf\ --disable-dap\ --enable-netcdf4\ --enable-pnetcdf\ --disable-libxml2\ --disable-byterange\ --enable-parallel-tests\ --enable-largefile\ --disable-hdf5
CONF_PARAMS="--prefix=${AGRINEER_WRF}/wrf --disable-dap --disable-netcdf4 --enable-pnetcdf --disable-libxml2 --disable-byterange --enable-shared"

export CC=$AGRINEER_WRF/wrf/bin/mpicc
export CPPFLAGS=-I$AGRINEER_WRF/wrf/include
export LDFLAGS=-L$AGRINEER_WRF/wrf/lib
make_lib

# wget https://downloads.unidata.ucar.edu/netcdf-fortran/4.6.1/netcdf-fortran-4.6.1.tar.gz
# netcdf-fortran-4.5.4 works without having HDF5, pnetcdf only
# netcdf-fortran-4.6.1 does not work without HDF5

clear_vars
#PNAME=netcdf-fortran-4.6.1
PNAME=netcdf-fortran-4.5.4
SUFFIX=tar.gz
CONF_PARAMS="--prefix=${AGRINEER_WRF}/wrf --enable-parallel-tests --enable-shared"
export LD_LIBRARY_PATH=$AGRINEER_WRF/wrf/lib
export CC=$AGRINEER_WRF/wrf/bin/mpicc
export CPPFLAGS=-I$AGRINEER_WRF/wrf/include
export FC=$AGRINEER_WRF/wrf/bin/mpif90
export LDFLAGS=-L$AGRINEER_WRF/wrf/lib
export LIBS="-lnetcdf -lpnetcdf -lm -ldl -lbz2"

make_lib

echo "Installing PNETCDF I/O WRF dependent libraries done"
